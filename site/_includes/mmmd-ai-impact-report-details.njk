{% set active_page = 'ai-impact' %}
{% extends "layout.njk" %}
{% block content %}

<link rel="stylesheet" href="{{ "/css/ai-impact-report.css" | assetVersion }}" />

{# ---------------------------------------------------------------- Hero #}
{% include "ai-impact-report-hero.njk" %}

{# ------------------------------------------------- How we did this work + Analyzing results #}
{% include "ai-impact-report-methods.njk" %}

{# ------------------------------------------------- Download the policy ideas (moved here from the report, 9/22) #}
<section id="download-data" class="style-body-text section-light">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.download_data.content | safe }}
        </div>
        <div class="download-button-div">
          <a class="download-button-link" data-appearance="button" data-theme="orange" href="/public/data/ai-impact-comments.csv" download>{{ modules.download_data.button_text }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- Sign up #}
{% include "ai-impact-report-sign-up.njk" %}

{# Same bundle as the report; only the demographics chart finds its root here. #}
<script src="{{ "/js/ai-impact-report.js" | assetVersion }}" defer></script>

{% endblock %}
