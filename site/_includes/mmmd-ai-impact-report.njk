{% set active_page = 'ai-impact' %}
{% extends "layout.njk" %}
{% block content %}

<link rel="stylesheet" href="/css/ai-impact-report.css" />

{% set ui = modules.tiers_ui %}
{% set nbr_tiers = ui.nbr_tiers | default(3) %}
{% set initial_visible = ui.initial_visible_ideas | default(3) %}
{% set total_ideas = 0 %}
{% for t in range(1, nbr_tiers + 1) %}
  {% set total_ideas = total_ideas + (modules["tier_" + t].nbr_ideas | default(0)) %}
{% endfor %}

{# Tier stickers, keyed by the tier module's `icon` field. Stickers include their own orange circle. #}
{% set tier_stickers = {
  "sparkle": "/public/images/ai-report-tier-most-support.svg",
  "heart": "/public/images/ai-report-tier-moderate-support.svg",
  "speech": "/public/images/ai-report-tier-some-support.svg"
} %}

{# Reusable: Region / Field of work toggle plus region legend. Static until the charts are built. #}
{% macro chart_controls(toggle_region, toggle_field_of_work, legend, show_participant_legend, participant_label, facilitator_label) %}
  <div class="chart-controls">
    <div class="chart-controls-row">
      <div class="segmented-toggle" role="group">
        <button type="button" class="segmented-toggle-option" aria-pressed="true" disabled>{{ toggle_region }}</button>
        <button type="button" class="segmented-toggle-option" aria-pressed="false" disabled>{{ toggle_field_of_work }}</button>
      </div>
      {% if show_participant_legend %}
        <ul class="chart-legend participant-legend">
          <li class="chart-legend-item"><span class="chart-legend-swatch swatch-participant" aria-hidden="true"></span>{{ participant_label }}</li>
          <li class="chart-legend-item"><span class="chart-legend-swatch swatch-facilitator" aria-hidden="true"></span>{{ facilitator_label }}</li>
        </ul>
      {% endif %}
    </div>
    <ul class="chart-legend region-legend" aria-label="{{ toggle_region }}">
      {% set nbr_regions = legend.nbr_regions | default(9) %}
      {% for r in range(1, nbr_regions + 1) %}
        <li class="chart-legend-item" data-region="{{ r }}"><span class="chart-legend-swatch" aria-hidden="true"></span>{{ legend["region_" + r] }}</li>
      {% endfor %}
    </ul>
  </div>
{% endmacro %}

{# Reusable: Phase label + title + subtitle on the left, one stat on the right. #}
{% macro phase_header(step, icon) %}
  <div class="row phase-row">
    <div class="col-lg-8">
      <p class="phase-label">{{ step.phase_label }}</p>
      <h3 class="phase-title">{{ step.phase_title }}</h3>
      <p class="phase-subtitle">{{ step.phase_subtitle }}</p>
    </div>
    <div class="col-lg-4">
      <div class="participation-sidebar">
        <div class="participation-stat">
          <img src="{{ icon }}" alt="" aria-hidden="true" />
          <div class="stat-number">{{ step.stat_count }}</div>
          <div class="stat-label">{{ step.stat_label }}</div>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{# ---------------------------------------------------------------- Hero #}
<section id="ai-report-hero" class="hero">
  <div class="container hero-container">
    <div class="row">
      <div class="col-lg-8 hero-content">
        {# Content begins with the H1; the subtitle field is inserted directly after it. #}
        {{ modules.hero.content | replace("</h1>", "</h1><p class=\"hero-subtitle\">" + modules.hero.subtitle + "</p>") | safe }}
      </div>
    </div>
    <img class="ai-report-hero-adornment" src="/public/images/ai-report-hero-adornment.svg" aria-hidden="true" alt="" />
  </div>
</section>

{# ------------------------------------------------- What: A public forum on AI #}
<section id="public-forum" class="style-body-text section-off-white">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.public_forum.content | safe }}
        </div>
      </div>
      <div class="col-lg-4">
        <div class="participation-sidebar">
          <div class="participation-stat">
            <img src="/public/images/staff-icon.svg" alt="" aria-hidden="true" />
            <div class="stat-number">{{ modules.participation_numbers.participants_count }}</div>
            <div class="stat-label">{{ modules.participation_numbers.participants_label }}</div>
          </div>
          <div class="participation-stat">
            <img src="/public/images/comments-icon.svg" alt="" aria-hidden="true" />
            <div class="stat-number">{{ modules.participation_numbers.conversations_count }}</div>
            <div class="stat-label">{{ modules.participation_numbers.conversations_label }}</div>
          </div>
          <div class="participation-stat">
            <img src="/public/images/ideas-icon.svg" alt="" aria-hidden="true" />
            <div class="stat-number">{{ modules.participation_numbers.ideas_count }}</div>
            <div class="stat-label">{{ modules.participation_numbers.ideas_label }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- Results: What we heard #}
<section id="what-we-heard" class="style-body-text">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.what_we_heard.content | safe }}
        </div>

        {# PLACEHOLDER: word cloud of poll responses. No design yet. #}
        <div id="word-cloud" class="chart-placeholder chart-placeholder-empty">
          <p class="chart-placeholder-empty-label">{{ modules.word_cloud.placeholder_label }}</p>
        </div>

        <div class="section-body">
          {{ modules.ranking.content | safe }}
        </div>

        {# Policy idea tiers. Rendered fully expanded; JS applies the collapsed default state. #}
        <div id="policy-tiers" class="policy-tiers"
             data-initial-visible="{{ initial_visible }}"
             data-show-label="{{ ui.show_label }}"
             data-show-more-label="{{ ui.show_more_label }}"
             data-close-label="{{ ui.close_label }}"
             data-show-all-label="{{ ui.show_all_label }}"
             data-close-all-label="{{ ui.close_all_label }}">

          {% for t in range(1, nbr_tiers + 1) %}
            {% set tier = modules["tier_" + t] %}
            {% set nbr_ideas = tier.nbr_ideas | default(0) %}
            <div class="policy-tier" id="policy-tier-{{ t }}" data-tier="{{ t }}" data-nbr-ideas="{{ nbr_ideas }}">
              <img class="policy-tier-icon policy-tier-sticker" src="{{ tier_stickers[tier.icon] | default(tier_stickers.sparkle) }}" alt="" aria-hidden="true" />
              <div class="policy-tier-header">
                <div class="policy-tier-heading">
                  <h3 class="policy-tier-title">{{ tier.title }}</h3>
                  <p class="policy-tier-subtitle">{{ tier.subtitle }}</p>
                </div>
                <p class="policy-tier-count">{{ ui.count_label | replace("{count}", nbr_ideas) }}</p>
              </div>

              <ul class="policy-ideas" id="policy-tier-{{ t }}-ideas">
                {% for i in range(1, nbr_ideas + 1) %}
                  {% set idea = modules["tier_" + t + "_idea_" + i] %}
                  {% set idea_id = "tier-" + t + "-idea-" + i %}
                  {% set has_body = idea.content and (idea.content | trim | length > 0) %}
                  <li class="policy-idea" data-index="{{ i }}">
                    <h4 class="policy-idea-title">
                      <button type="button" class="policy-idea-toggle"
                              aria-expanded="false"
                              aria-controls="{{ idea_id }}-body"
                              id="{{ idea_id }}-toggle"
                              {% if not has_body %}data-empty="true"{% endif %}>
                        <span class="policy-idea-title-text">{{ idea.title }}</span>
                        <span class="policy-idea-toggle-icon" aria-hidden="true"></span>
                      </button>
                    </h4>
                    <div class="policy-idea-body" id="{{ idea_id }}-body" role="region" aria-labelledby="{{ idea_id }}-toggle" hidden>
                      {% if has_body %}
                        {# Body markdown is: description paragraph(s), then a bullet list of example ideas. #}
                        {{ idea.content | replace("<ul>", '<p class="policy-idea-examples-label">' + ui.example_ideas_label + '</p><ul class="policy-idea-examples">') | safe }}
                      {% else %}
                        {# TODO: description and example ideas for this idea have not been written yet. #}
                      {% endif %}
                    </div>
                  </li>
                {% endfor %}
              </ul>

              <div class="policy-tier-footer">
                <button type="button" class="policy-tier-toggle text-link-button"
                        aria-expanded="true"
                        aria-controls="policy-tier-{{ t }}-ideas">
                  <span class="policy-tier-toggle-text">{{ ui.close_label }}</span>
                  <span class="chevron" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          {% endfor %}

          <div class="policy-tiers-footer">
            <button type="button" id="policy-tiers-toggle-all" class="text-link-button"
                    aria-expanded="true"
                    aria-controls="policy-tiers"
                    data-total-ideas="{{ total_ideas }}">
              <span class="policy-tiers-toggle-all-text">{{ ui.close_all_label }}</span>
              <span class="chevron" aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="how-to-read-tiers style-body-text">
          {{ modules.how_to_read_tiers.content | safe }}
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------- Results, continued: The power of discussion #}
<section id="power-of-discussion" class="style-body-text section-light">
  <div class="container">
    <h2>{{ modules.power_of_discussion.title }}</h2>
    {{ phase_header(modules.power_of_discussion, "/public/images/comments-icon.svg") }}

    {# PLACEHOLDER: this will become an interactive conversations ring chart with a pop-out panel. #}
    <div id="conversations-chart" class="chart-placeholder">
      <img class="chart-placeholder-image" src="/public/images/ai-report-conversations-chart-placeholder.png" alt="{{ modules.power_of_discussion.chart_alt }}" />
    </div>

    {# Download the comments: an H3 sub-block of this section, per the writer's outline. #}
    <div id="download-data" class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.download_data.content | safe }}
        </div>
        <div class="download-button-div">
          <a class="download-button-link" data-appearance="button" data-theme="orange" href="/public/data/ai-impact-comments.csv" download>{{ modules.download_data.button_text }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- Who participated (animated funnel) #}
{# Four-stage canvas animation driven by participant-funnel.js. Stage copy is HTML below
   (one .participants-step per stage) and crossfades with the dots. Without JS the four
   steps stack with their static snapshots and the controls are hidden. #}
<section id="who-participated" class="style-body-text">
  <div class="container">
    {% set wp = modules.who_participated %}
    {% set nbr_steps = wp.nbr_steps | default(4) %}
    {% set step_icons = ["/public/images/staff-icon.svg", "/public/images/staff-icon.svg", "/public/images/staff-icon.svg", "/public/images/comments-icon.svg"] %}
    {# English category names as they appear in the data, in the same order as region_legend, so the
       legend can be translated. #}
    {% set region_keys = ["Los Angeles", "Bay Area", "Southern California", "Sacramento Valley / Sierra Foothills", "Central Valley", "Far North / North Coast", "Central Coast", "Sierra Region", "(not stated)"] %}
    {% set legend_labels_json %}{ {% for key in region_keys %}{{ key | dump | safe }}: {{ modules.region_legend["region_" + loop.index] | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %} }{% endset %}

    <h2>{{ wp.title }}</h2>

    <div id="participants-stepper" class="participants-stepper" tabindex="0"
         data-funnel-src="/public/data/ai-report-participant-funnel.json"
         data-step="1" data-variant="region"
         data-step-counter="{{ wp.step_counter }}"
         data-play-label="{{ wp.play_label }}"
         data-pause-label="{{ wp.pause_label }}"
         data-center-title="{{ wp.ring_center_title }}"
         data-center-hint="{{ wp.ring_center_hint }}"
         data-labels='{{ legend_labels_json | replace("'", "&#39;") | safe }}'>
      {# Margin arrows: kept for now, may go away. Hidden at either end. #}
      <button type="button" class="stepper-arrow stepper-arrow-prev" data-stepper-prev aria-label="{{ wp.prev_label }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M8 3L2.5 9L8 15M3 9H15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="stepper-arrow stepper-arrow-next" data-stepper-next aria-label="{{ wp.next_label }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M10 3L15.5 9L10 15M15 9H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="visually-hidden" data-stepper-counter aria-live="polite">{{ wp.step_counter | replace("{current}", 1) | replace("{total}", nbr_steps) }}</span>

      {# Stage copy. JS shows one at a time and crossfades; no-JS shows all four with snapshots. #}
      <div class="participants-steps">
        {% for s in range(1, nbr_steps + 1) %}
          {% set step = modules["who_participated_step_" + s] %}
          <div class="participants-step" id="who-participated-step-{{ s }}" data-step="{{ s }}" role="group" aria-roledescription="step" aria-label="{{ step.phase_title }}">
            {{ phase_header(step, step_icons[s - 1]) }}
            <div class="chart-placeholder funnel-static-fallback">
              <img class="chart-placeholder-image" src="{{ step.chart_image_region }}" alt="{{ step.chart_alt }}" />
            </div>
          </div>
        {% endfor %}
      </div>

      {# The animation. Sized by JS to the 1040-wide canvas space. #}
      <div class="funnel-stage">
        <canvas data-funnel-canvas width="1040" height="596" role="img" aria-label="{{ wp.chart_alt }}"></canvas>
      </div>

      <div class="chart-controls">
        <div class="chart-controls-row">
          <div class="segmented-toggle" role="group">
            <button type="button" class="segmented-toggle-option" data-variant="region" aria-pressed="true" disabled>{{ wp.toggle_region }}</button>
            <button type="button" class="segmented-toggle-option" data-variant="field" aria-pressed="false" disabled>{{ wp.toggle_field_of_work }}</button>
          </div>
          <ul class="chart-legend participant-legend" data-last-step-only hidden>
            <li class="chart-legend-item"><span class="chart-legend-swatch swatch-participant" aria-hidden="true"></span>{{ wp.legend_participant }}</li>
            <li class="chart-legend-item"><span class="chart-legend-swatch swatch-facilitator" aria-hidden="true"></span>{{ wp.legend_facilitator }}</li>
          </ul>
        </div>
        {# Filled from the data by JS; the static region list is the no-JS fallback. #}
        <ul class="chart-legend region-legend" data-funnel-legend aria-label="{{ wp.toggle_region }}">
          {% set nbr_regions = modules.region_legend.nbr_regions | default(9) %}
          {% for r in range(1, nbr_regions + 1) %}
            <li class="chart-legend-item" data-region="{{ r }}"><span class="chart-legend-swatch" aria-hidden="true"></span>{{ modules.region_legend["region_" + r] }}</li>
          {% endfor %}
        </ul>
      </div>

      <div class="funnel-controls">
        <button type="button" class="funnel-button funnel-button-primary" data-funnel-play aria-pressed="false">{{ wp.pause_label }}</button>
        <button type="button" class="funnel-button funnel-button-outline" data-funnel-restart>{{ wp.restart_label }}</button>
        <div class="funnel-controls-spacer"></div>
        <div class="funnel-pills" role="group" aria-label="{{ wp.title }}">
          {% for s in range(1, nbr_steps + 1) %}
            <button type="button" class="funnel-pill" data-funnel-stage="{{ s }}" aria-pressed="{% if s == 1 %}true{% else %}false{% endif %}">{{ modules["who_participated_step_" + s].pill_label }}</button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- What happens next #}
<section id="what-happens-next" class="style-body-text section-off-white">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.what_happens_next.content | safe }}
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- How we did this work #}
<section id="how-we-did-this-work" class="style-body-text section-navy">
  <div class="container">
    <h2>{{ modules.how_we_did_this_work.title }}</h2>

    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.balancing_groups.content | safe }}
        </div>
      </div>
    </div>

    {# Demographics chart: Phase 1 / Phase 2 vs statewide target, one dimension at a time.
       Drawn by demographics-chart.js from /public/data/ai-report-demographics.json. #}
    {% set dc = modules.demographics_chart %}
    {% set ds = modules.demographics_sources %}
    {% set dims = [
      ["region", dc.dim_region, ds.source_region],
      ["race", dc.dim_race, ds.source_race],
      ["age", dc.dim_age, ds.source_age],
      ["gender", dc.dim_gender, ds.source_gender],
      ["field", dc.dim_field, ds.source_field_of_work],
      ["ai", dc.dim_ai, ds.source_ai]
    ] %}
    <div id="demographics-chart" class="demographics-chart"
         data-demographics-chart
         data-src="/public/data/ai-report-demographics.json"
         data-dimension="region"
         data-phase1-label="{{ dc.phase1_label }}"
         data-phase2-label="{{ dc.phase2_label }}"
         data-on-target-label="{{ dc.on_target_label }}"
         data-table-caption="{{ dc.table_caption }}">
      <div class="row">
        <div class="col-lg-8">
          <h4 class="demographics-title">{{ dc.title }}</h4>
          <div class="section-body demographics-intro">
            {{ dc.content | safe }}
          </div>
        </div>
      </div>

      <div class="demographics-controls">
        <label class="demographics-select-label" for="demographics-select">{{ dc.pulldown_label }}</label>
        <span class="demographics-select-wrap">
          <select id="demographics-select" class="demographics-select" data-demographics-select disabled>
            {% for d in dims %}
              <option value="{{ d[0] }}"{% if loop.first %} selected{% endif %}>{{ d[1] }}</option>
            {% endfor %}
          </select>
        </span>
      </div>

      <p class="demographics-chart-title">{{ dc.chart_title }}</p>
      <div class="demographics-svg-host" data-demographics-svg>
        {# No-JS fallback: the static Region snapshot. #}
        <img class="chart-placeholder-image" src="/public/images/ai-report-sortition-chart-placeholder.png" alt="{{ dc.chart_alt }}" />
      </div>
      <div data-demographics-table></div>

      {% for d in dims %}
        {% if d[2] %}
          <div class="demographics-source" data-source-for="{{ d[0] }}"{% if not loop.first %} hidden{% endif %}>
            <p class="demographics-source-label">{{ ds.label }}</p>
            <ul>
              <li>{{ d[2] | markdownInline | safe }}</li>
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="row">
      <div class="col-lg-8">
        <div class="section-body process-links">
          {{ modules.process_links.content | safe }}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="analyzing-results" class="style-body-text">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="section-body">
          {{ modules.analyzing_results.content | safe }}
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------- Sign up (left-aligned, as on the efficiency report) #}
<section id="stay-informed" class="style-body-text section-navy">
  <img src="/public/images/bubble-cluster-1.svg" class="signup-cluster-1" aria-hidden="true" alt="" />
  <img src="/public/images/bubble-cluster-2.svg" class="signup-cluster-2" aria-hidden="true" alt="" />
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="signup-engaged-section">
          {{ modules.sign_up.content | safe }}
          <a href="https://join.engaged.ca.gov/" data-appearance="button" data-theme="orange">
            {{ modules.sign_up.button_text }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/ai-impact-report.js" defer></script>

{% endblock %}
